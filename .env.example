# preboard/ (Python) — the CLI, app.py, and server.py all read these directly.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=
# DATABRICKS_FM_ENDPOINT=databricks-claude-sonnet-4-5
# DATABRICKS_WAREHOUSE_ID=  # bare warehouse id; enables the Unity Catalog corpus. Omit to use local data/*.md.
# DATABRICKS_HTTP_PATH=  # PR12/NOTES.md §19, D6: the frontend's name for the same warehouse
#                         # (e.g. /sql/1.0/warehouses/<id>) — set this OR DATABRICKS_WAREHOUSE_ID, not both.
# DATABRICKS_CATALOG=workspace  # defaults shown; only needed if your workspace uses different names
# DATABRICKS_SCHEMA=preboard
# PREBOARD_AUTH_SECRET=  # required for the deployed Streamlit app; local dev falls back to a dev-only constant (auth.py)

# frontend/ (Next.js) — see frontend/.env.example for the full set (DATA_MODE, AUTH_SECRET,
# PYTHON_API_URL pointing at `uvicorn server:app`, etc.). Listed here per PR12/NOTES.md §19,
# D6's "one .env.example documents both processes" — the frontend reads its own file, this
# isn't a shared/loaded file between the two processes.
